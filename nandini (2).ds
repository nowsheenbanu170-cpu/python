   "source": [
    "\n",
    "    import pandas as pd\n",
    "data1 = {\n",
    "    \"ID\":[1,2,3],\n",
    "    \"Name\":[\"Rahul\",\"Sneha\",\"Amit\"],\n",
    "    \"Marks\":[85,92,76]\n",
    "}\n",
    "data2 = {\n",
    "    \"ID\":[4,5],\n",
    "    \"Name\":[\"Priya\",\"Roshan\"],\n",
    "    \"Marks\":[88,95]\n",
    "}\n",
    "df1 = pd.DataFrame(data1)\n",
    "df2 = pd.DataFrame(data2)\n",
    "print(\"DataFrame 1:\")\n",
    "print(df1)\n",
    "print(\"\\nDataFrame 2:\")\n",
    "print(df2)\n",
    "\n",
    "df_concat = pd.concat([df1,df2],ignore_index=True)\n",
    "print(\"\\nConcatenated DataFrame:\")\n",
    "print(df_concat)\n",
    "\n",
    "print(\"\\nStudents with Marks greater than 80:\")\n",
    "print(df_concat[df_concat[\"Marks\"]>80])\n",
    "\n",
    "df_concat[\"Grade\"] = [\"B\",\"A\",\"C\",\"B\",\"A\"]\n",
    "print(\"\\nDataFrame after adding grade column:\")\n",
    "print(df_concat)         "
   ]
  },
